{
  "_comment": "paper medium (style_spec 2.1, 2.2): a journal column split into touching panels (--layout facets: up to 2 single plots side by side, double column), a lower panel shares its height; no titles (the caption is the title). Save as PDF.",
  "mplstyle": "paper.mplstyle",
  "width": "single",
  "aspect": 0.75,
  "layout": "panels",
  "lower_panels": "share",
  "facet_columns": 2,
  "font_sizes": {
    "titlefontsize": "large", "subtitlefontsize": "medium",
    "legendtitlefontsize": "medium", "legendfontsize": "medium",
    "xlabelfontsize": "large", "ylabelfontsize": "large",
    "xsublabelfontsize": "medium", "ysublabelfontsize": "large",
    "linelabelfontsize": "small"
  },
  "plot_settings": {
    "auto_title": false,
    "titles": false,
    "text_scale": 0.75,
    "error_label": false,
    "default_linewidth": 1.2,
    "figure_layout": {
      "margins_inches": {"left": 0.3, "right": 0.08, "bottom": 0.25, "top": 0.08, "wspace": 0.3, "hspace": 0.3}
    },
    "legend_style": {"fontsize": "medium", "title_fontsize": "medium", "frameon": false, "loc": "best"},
    "note_style": {"fontsize": "medium", "bbox": {"boxstyle": "square,pad=0.3", "facecolor": "role:paper",
                                                  "alpha": 0.85, "edgecolor": "none", "linewidth": 0}}
  }
}
