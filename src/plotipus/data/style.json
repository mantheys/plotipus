{
  "rcparams": {
    "font.size": 11
  },
  "font_sizes": {
    "titlefontsize": "xx-large",
    "subtitlefontsize": "x-large",
    "legendtitlefontsize": "xx-large",
    "legendfontsize": "x-large",
    "xlabelfontsize": "xx-large",
    "ylabelfontsize": "xx-large",
    "xsublabelfontsize": "x-large",
    "ysublabelfontsize": "x-large",
    "linelabelfontsize": "large"
  },
  "plot_settings": {
    "nbins": 50,
    "default_linewidth": 2,
    "band_alpha": 0.2,
    "figure_layout": {
      "base_width": 8,
      "panel_width": 5,
      "height": 6,
      "margins_inches": {
        "left": 0.96,
        "right": 0.4,
        "bottom": 0.72,
        "top": 0.6,
        "wspace": 0.25,
        "hspace": 0.15
      },
      "two_panel_hspace": 0.15,
      "panel_font_scale": {
        "3": 1.3333
      }
    },
    "legend_style": {
      "fontsize": "x-large",
      "title_fontsize": "xx-large",
      "frameon": false,
      "loc": "best"
    },
    "note_style": {
      "fontsize": "large",
      "bbox": {
        "boxstyle": "round,pad=0.5",
        "facecolor": "role:paper",
        "alpha": 0.8,
        "edgecolor": "role:muted",
        "linewidth": 0.5
      }
    }
  }
}