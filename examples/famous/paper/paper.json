{
  "mplstyle": "../../../docs/design/styles/paper/plotipus-paper.mplstyle",
  "rcparams": {
    "axes.prop_cycle": "cycler('color', ['black', '#e41a1c', '#377eb8', '#4daf4a', '#ff7f00', '#984ea3', '#a65628', '#f781bf', '#999999'])",
    "image.cmap": "inferno"
  },
  "font_sizes": {
    "titlefontsize": "large", "subtitlefontsize": "medium",
    "legendtitlefontsize": "medium", "legendfontsize": "medium",
    "xlabelfontsize": "large", "ylabelfontsize": "large",
    "xsublabelfontsize": "medium", "ysublabelfontsize": "medium",
    "linelabelfontsize": "small"
  },
  "plot_settings": {
    "default_linewidth": 1.2,
    "figure_layout": {
      "base_width": 3.5, "panel_width": 3.2, "height": 2.7,
      "margins_inches": {"left": 0.62, "right": 0.12, "bottom": 0.42, "top": 0.22, "wspace": 0.3, "hspace": 0.35},
      "two_panel_hspace": 0.06,
      "panel_font_scale": {"3": 1.0}
    },
    "legend_style": {"fontsize": "medium", "title_fontsize": "medium", "frameon": false, "loc": "best"},
    "note_style": {"fontsize": "medium", "bbox": {"boxstyle": "square,pad=0.3", "facecolor": "white", "alpha": 0.85,
                                                  "edgecolor": "none"}}
  }
}
